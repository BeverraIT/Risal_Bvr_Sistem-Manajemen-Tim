NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Koneksi Postgres langsung -- hanya dipakai scripts/apply-migration.mjs,
# bukan oleh aplikasi. Ambil dari Vercel (POSTGRES_URL_NON_POOLING, hasil
# integrasi Supabase) atau Supabase -> Project Settings -> Database ->
# Connection string -> URI. Wajib koneksi non-pooling: migrasi menjalankan
# DDL, dan pooler mode transaction menolak sebagian perintahnya.
DATABASE_URL=

# Opsional -- pipeline notulen AI memakai Gemini secara default.
GEMINI_API_KEY=
# Jalur alternatif transkripsi/ringkasan bila diisi.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Notifikasi WhatsApp saat notulen selesai diproses.
FONNTE_TOKEN=
